# Copy to .env and replace SECRET_KEY with a random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-48-byte-value

# development | production
ENV=development
DEBUG=false

DATABASE_URL=sqlite:///./data/app.db
FRONTEND_ORIGIN=http://localhost:5173

# Session policy
SESSION_COOKIE_NAME=__Host-ra_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=true